# App
NODE_ENV=development
PORT=3001

# Dev only: fixed OTP when SMS/Firebase is not configured (ignored in production)
DEV_OTP_CODE=123456

# Database
DATABASE_URL=postgresql://dii:dii_password@localhost:5433/dii_db?schema=public

# Mobile JWT
MOBILE_JWT_SECRET=change-me-mobile-jwt-secret
MOBILE_JWT_REFRESH_SECRET=change-me-mobile-refresh-secret
MOBILE_JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_REFRESH_SECRET=change-me-admin-refresh-secret
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OAuth (Mobile)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# S3 / MinIO (Uploads)
# Dev: MinIO via docker-compose (API :9000, Console :9001)
AWS_REGION=us-east-1
AWS_S3_BUCKET=dii-uploads
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_URL=http://localhost:9000/dii-uploads
# Prod: leave AWS_S3_ENDPOINT empty and set real AWS credentials

# External Services
# Mapbox public token (pk.*) — same value as dii-app EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN
MAPBOX_ACCESS_TOKEN=
# Optional overrides (defaults match dii-app Discover map)
# MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
# MAPBOX_DEFAULT_ZOOM=13.4
# MAPBOX_DEFAULT_LATITUDE=21.0285
# MAPBOX_DEFAULT_LONGITUDE=105.8542
FCM_SERVER_KEY=
SENDGRID_API_KEY=
